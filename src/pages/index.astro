---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('notes')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const groups = [
  { key: 'published', zh: '已完成', en: 'Published' },
  { key: 'draft', zh: '写作中', en: 'In progress' },
  { key: 'todo', zh: '待研究', en: 'To explore' },
].map((g) => ({ ...g, items: all.filter((n) => n.data.status === g.key) })).filter((g) => g.items.length);
---
<Base title="pixel notes · 源码级学习笔记" description="对照源码写成的 Agent 工程学习笔记，每个结论锁定到具体提交。">
  <div class="wrap">
    <section class="hero">
      <div class="eyebrow">Source-level notes</div>
      <h1 data-zh="学习笔记" data-en="Learning notes">学习笔记</h1>
      <p data-zh="对照源码写成的 Agent 工程笔记：每个结论锁定到具体提交，写清设计取舍与边界情况。" data-en="Agent-engineering notes written against the source. Every claim is pinned to a commit, with design trade-offs and edge cases spelled out.">对照源码写成的 Agent 工程笔记：每个结论锁定到具体提交，写清设计取舍与边界情况。</p>
    </section>
    <section id="notes" class="list">
      {groups.map((g) => (
        <>
          <div class="group-title"><span data-zh={g.zh} data-en={g.en}>{g.zh}</span></div>
          {g.items.map((n) => (
            <a class="card" href={`/notes/${n.id}/`}>
              <div class="meta"><time datetime={n.data.date}>{n.data.date}</time><span>{n.data.topic}</span>{n.data.pinned && <span class="tag">{n.data.pinned}</span>}</div>
              <h3 data-zh={n.data.title} data-en={n.data.titleEn ?? n.data.title}>{n.data.title}</h3>
              <p data-zh={n.data.summary} data-en={n.data.summaryEn ?? n.data.summary}>{n.data.summary}</p>
            </a>
          ))}
        </>
      ))}
    </section>
  </div>
</Base>
