---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AsciiPortrait from '../components/AsciiPortrait.astro';

const slogan = { zh: '前沿Agentic harness学习笔记', en: 'Notes on frontier agentic harnesses' };
const all = (await getCollection('notes')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const en = Object.fromEntries(await Promise.all(all.map(async (n) => [n.id, (await getEntry('notesEn', n.id))?.data])));
const groups = [
  { key: 'published', zh: '已完成', en: 'Published' },
  { key: 'draft', zh: '写作中', en: 'In progress' },
  { key: 'todo', zh: '待研究', en: 'To explore' },
].map((g) => ({ ...g, items: all.filter((n) => n.data.status === g.key) })).filter((g) => g.items.length);
---
<Base title={`pixel notes · ${slogan.zh}`} titleEn={`pixel notes · ${slogan.en}`} description="对照源码写成的 Agent 工程笔记：每个结论固定到具体提交，写清设计取舍与边界情况。">
  <div class="wrap">
    <section class="hero">
      <div class="intro">
        <h1 data-zh={slogan.zh} data-en={slogan.en}>{slogan.zh}</h1>
        <a class="leaderboard" href="https://frontierharness.org/">
          <span data-zh="Frontier Harness 榜单" data-en="Frontier Harness leaderboard">Frontier Harness 榜单</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="art"><AsciiPortrait /></div>
    </section>
    <section id="notes" class="list" aria-label="notes">
      {groups.map((g) => (
        <>
          <div class="group-title"><span data-zh={g.zh} data-en={g.en}>{g.zh}</span></div>
          {g.items.map((n) => (
            <a class={`entry ${n.data.status}`} href={`/notes/${n.id}/`}>
              <time datetime={n.data.date}>{n.data.date}</time>
              <div>
                <h3><span data-zh={n.data.title} data-en={en[n.id]?.title ?? n.data.titleEn ?? n.data.title}>{n.data.title}</span><span class="arrow" aria-hidden="true">→</span></h3>
                <p data-zh={n.data.summary} data-en={en[n.id]?.summary ?? n.data.summaryEn ?? n.data.summary}>{n.data.summary}</p>
                <div class="meta"><span data-zh={n.data.topic} data-en={en[n.id]?.topic ?? n.data.topic}>{n.data.topic}</span></div>
              </div>
            </a>
          ))}
        </>
      ))}
    </section>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: center;
    column-gap: clamp(24px, 3vw, 42px);
    padding: 52px 0 22px;
  }

  .intro { container-type: inline-size; }
  .intro h1 {
    font-size: clamp(1.25rem, 7cqi, 2.75rem);
    text-wrap: balance;
  }
  .intro h1:lang(en) { font-size: clamp(1rem, 5.6cqi, 2.25rem); }
  .leaderboard {
    display: inline-flex;
    align-items: baseline;
    gap: .35em;
    color: var(--fg-2);
    text-decoration: underline;
    text-decoration-color: var(--plat);
    text-underline-offset: .25em;
  }
  .leaderboard:hover, .leaderboard:focus-visible { color: var(--fg); text-decoration-color: currentColor; }

  @media (max-width: 600px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 36px 0 0;
    }
    .art {
      width: min(84%, 300px);
      justify-self: center;
    }
  }
</style>
