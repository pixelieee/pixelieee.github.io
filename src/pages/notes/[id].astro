---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('notes')).sort((a, b) => a.data.date.localeCompare(b.data.date) || a.id.localeCompare(b.id));
  const pub = all.filter((n) => n.data.status !== 'todo');
  return all.map((note) => {
    const i = pub.findIndex((n) => n.id === note.id);
    return { params: { id: note.id }, props: { note, prev: i > 0 ? pub[i - 1] : null, next: i >= 0 && i < pub.length - 1 ? pub[i + 1] : null } };
  });
}
const { note, prev, next } = Astro.props;
const { Content, headings } = await render(note);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const words = (note.body ?? '').replace(/```[\s\S]*?```/g, '').match(/[一-鿿]|[A-Za-z0-9]+/g)?.length ?? 0;
const minutes = Math.max(1, Math.round(words / 400));
---
<Base title={`${note.data.title} · pixel notes`} description={note.data.summary}>
  <div id="progress"></div>
  <div class="wrap article-grid">
    <nav class="toc" aria-label="contents">
      {toc.map((h) => <a class={h.depth === 2 ? 'd2' : 'd3'} href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <article>
      <a class="back" href="/#notes">← <span data-zh="所有笔记" data-en="All notes">所有笔记</span></a>
      <div class="eyebrow" style="margin-top:20px">{note.data.topic}{note.data.pinned ? ` · ${note.data.pinned}` : ''}</div>
      <h1 data-zh={note.data.title} data-en={note.data.titleEn ?? note.data.title}>{note.data.title}</h1>
      <div class="meta"><time datetime={note.data.date}>{note.data.date}</time><span>{words.toLocaleString('en-US')} <span data-zh="字" data-en="words">字</span></span><span data-zh={`约 ${minutes} 分钟`} data-en={`${minutes} min read`}>{`约 ${minutes} 分钟`}</span></div>
      <div class="prose"><Content /></div>
      <div class="pager">
        {prev ? <a href={`/notes/${prev.id}/`}>← <span data-zh={prev.data.title} data-en={prev.data.titleEn ?? prev.data.title}>{prev.data.title}</span></a> : <span />}
        {next ? <a href={`/notes/${next.id}/`}><span data-zh={next.data.title} data-en={next.data.titleEn ?? next.data.title}>{next.data.title}</span> →</a> : <span />}
      </div>
    </article>
  </div>
  <script is:inline>
  (function(){
    var bar=document.getElementById('progress');
    var links=[].slice.call(document.querySelectorAll('.toc a'));
    var heads=links.map(function(a){return document.getElementById(decodeURIComponent(a.hash.slice(1)))});
    function tick(){
      var h=document.documentElement,max=h.scrollHeight-h.clientHeight;
      bar.style.width=(max>0?h.scrollTop/max*100:0)+'%';
      var cur=-1;for(var i=0;i<heads.length;i++){if(heads[i]&&heads[i].getBoundingClientRect().top<120)cur=i}
      links.forEach(function(a,i){a.classList.toggle('on',i===cur)});
    }
    addEventListener('scroll',tick,{passive:true});tick();
  })();
  </script>
</Base>
