---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
const { title, description = '源码级 Agent 工程学习笔记。' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:type" content="website">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<script is:inline>
(function(){var r=document.documentElement,g=function(k){try{return localStorage.getItem(k)}catch(e){return null}};
var t=g('pixel-theme');r.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
r.lang=g('pixel-language')==='en'?'en':'zh-CN';})();
</script>
</head>
<body>
<a class="skip" href="#main"><span data-zh="跳到正文" data-en="Skip to content">跳到正文</span></a>
<header class="site"><div class="wrap">
  <a class="brand" href="/" aria-label="pixel notes"><Logo /><b>pixel notes</b></a>
  <nav class="main" aria-label="main">
    <a class="lnk" href="/#notes"><span data-zh="笔记" data-en="Notes">笔记</span></a>
    <button class="ctl" id="lang" type="button"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18"/></svg><span id="lang-label">EN</span></button>
    <button class="ctl" id="theme" type="button" aria-label="theme"><svg class="moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z"/></svg><svg class="sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
  </nav>
</div></header>
<main id="main"><slot /></main>
<footer class="site"><div class="wrap">pixel notes · <span data-zh="源码级学习笔记" data-en="Source-level learning notes">源码级学习笔记</span></div></footer>
<script is:inline>
(function(){var r=document.documentElement,s=function(k,v){try{localStorage.setItem(k,v)}catch(e){}};
function applyLang(){var en=r.lang==='en';
document.querySelectorAll('[data-zh]').forEach(function(e){e.textContent=en?e.dataset.en:e.dataset.zh});
document.getElementById('lang-label').textContent=en?'中':'EN';
document.getElementById('lang').setAttribute('aria-label',en?'切换中文界面':'Switch interface to English');
document.getElementById('theme').setAttribute('aria-label',en?'Toggle theme':'切换主题')}
document.getElementById('lang').onclick=function(){r.lang=r.lang==='en'?'zh-CN':'en';s('pixel-language',r.lang);applyLang()};
document.getElementById('theme').onclick=function(){var d=r.dataset.theme==='dark'?'light':'dark';r.dataset.theme=d;s('pixel-theme',d)};
applyLang()})();
</script>
</body>
</html>
