---
import '@fontsource/noto-serif-sc/600.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
const {
  title, titleEn,
  description = '对照源码写成的 Agent 工程笔记。', descriptionEn,
  type = 'website', published,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="zh-CN" data-theme="light" data-ui="zh" data-title-zh={title} data-title-en={titleEn ?? title}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#F7F7F8" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0C0D0F" media="(prefers-color-scheme: dark)">
<meta property="og:site_name" content="pixel notes">
<meta property="og:title" content={title}><meta property="og:description" content={description}>
<meta property="og:type" content={type}><meta property="og:url" content={canonical}>
<meta property="og:locale" content="zh_CN"><meta property="og:locale:alternate" content="en_US">
{published && <meta property="article:published_time" content={published}>}
<meta name="twitter:card" content="summary">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/rss+xml" title="pixel notes" href="/rss.xml">
<link rel="sitemap" href="/sitemap-index.xml">
<script is:inline>
(function(){var r=document.documentElement,g=function(k){try{return localStorage.getItem(k)}catch(e){return null}};
var t=g('pixel-theme');r.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
var l=g('pixel-language');var ui=l?(l==='en'?'en':'zh'):(/^zh/i.test(navigator.language||'zh')?'zh':'en');
r.dataset.ui=ui;r.lang=ui==='en'?'en':'zh-CN';
if(g('pixel-codetr')==='on')r.dataset.codetr='on';
if(ui==='en'&&r.dataset.titleEn)document.title=r.dataset.titleEn;})();
</script>
</head>
<body>
<a class="skip" href="#main"><span data-zh="跳到正文" data-en="Skip to content">跳到正文</span></a>
<header class="site"><div class="wrap">
  <a class="brand" href="/" aria-label="pixel notes"><Logo /><b>p<span class="tittle">ı</span>xel notes</b></a>
  <nav class="main" aria-label="main">
    <a class="lnk" href="/#notes"><span data-zh="笔记" data-en="Notes">笔记</span></a>
    <div class="ctl-group">
      <div class="seg" role="group" aria-label="语言 / Language">
        <button type="button" data-set-ui="zh" aria-pressed="true" lang="zh-CN">中</button>
        <button type="button" data-set-ui="en" aria-pressed="false" lang="en">EN</button>
      </div>
      <span class="ctl-sep" aria-hidden="true"></span>
      <button class="icon-btn" id="theme" type="button" aria-label="切换主题">
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4 6.5 6.5 0 0 0 20 14.5z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"/></svg>
      </button>
    </div>
  </nav>
</div></header>
<main id="main"><slot /></main>
<footer class="site"><div class="wrap">
  <span>pixel notes · <span data-zh="对照源码的学习笔记" data-en="Notes written against the source">对照源码的学习笔记</span></span>
  <nav aria-label="footer"><a href="/rss.xml">RSS</a><a href="https://github.com/pixelieee/pixelieee.github.io" rel="noopener">GitHub</a></nav>
</div></footer>
<script is:inline>
(function(){var r=document.documentElement,s=function(k,v){try{localStorage.setItem(k,v)}catch(e){}};
function apply(initial){var en=r.dataset.ui==='en';
  r.lang=en?'en':'zh-CN';
  document.querySelectorAll('[data-zh]').forEach(function(e){var v=en?e.dataset.en:e.dataset.zh;if(v!=null)e.textContent=v});
  document.querySelectorAll('[data-set-ui]').forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.setUi===r.dataset.ui))});
  document.getElementById('theme').setAttribute('aria-label',en?'Toggle theme':'切换主题');
  var t=en?r.dataset.titleEn:r.dataset.titleZh;if(t)document.title=t;
  document.dispatchEvent(new CustomEvent('ui-change',{detail:{initial:!!initial}}));}
document.querySelectorAll('[data-set-ui]').forEach(function(b){b.addEventListener('click',function(){
  if(r.dataset.ui===b.dataset.setUi)return;r.dataset.ui=b.dataset.setUi;s('pixel-language',r.dataset.ui);apply()})});
document.getElementById('theme').addEventListener('click',function(){var d=r.dataset.theme==='dark'?'light':'dark';r.dataset.theme=d;s('pixel-theme',d)});
document.addEventListener('click',function(e){var b=e.target.closest&&e.target.closest('.tr-toggle');if(!b)return;
  var on=r.dataset.codetr!=='on';if(on)r.dataset.codetr='on';else delete r.dataset.codetr;s('pixel-codetr',on?'on':'off');
  document.querySelectorAll('.tr-toggle').forEach(function(x){x.setAttribute('aria-pressed',String(on))})});
apply(true)})();
</script>
</body>
</html>
