---
const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const rows = [
  { label: en ? 'First call' : '首次调用', system: 'RULE_A · DESC_A', messages: ['BODY_A'], note: en ? 'The first /skill:release call reads BODY_A from disk and appends it as user message #1.' : '第 1 次调用 /skill:release，从磁盘读出 BODY_A 作为用户消息发给模型。' },
  { label: en ? 'Edit on disk' : '改磁盘文件后', system: 'RULE_A · DESC_A', messages: ['BODY_A', 'BODY_B'], note: en ? 'One request now holds the stale RULE_A · DESC_A prompt, the earlier BODY_A turn, and the newly read BODY_B body.' : '同一份请求里，system 仍是旧的 RULE_A · DESC_A，第 1 条用户消息留着旧正文 BODY_A，第 2 条用户消息已是刚从磁盘读出的新正文 BODY_B。' },
  { label: en ? 'New name' : '调用新名字', system: 'RULE_A · DESC_A', messages: ['BODY_A', 'BODY_B', '/skill:late'], note: en ? 'The late skill file exists on disk, but the in-memory catalog has not rescanned yet, so /skill:late goes through as literal text.' : '磁盘上已有 late 的文件，但内存索引表还没重新扫描，/skill:late 被当成普通聊天文字原样发给了模型。' },
  { label: en ? 'Reload' : '执行 /reload 后', system: 'RULE_B · DESC_B · NEW_SKILL', messages: ['BODY_A', 'BODY_B', '/skill:late', 'BODY_B'], note: en ? '/reload appends a system update so replaying yields B; earlier user turns are never rewritten and keep what they originally sent.' : '/reload 追加了一条新的 system 更新消息，合并后生效的是 B 版规则与索引表；前几轮发过的用户消息不会改写，各自保留当时的内容。' },
  { label: en ? 'Fresh session' : '新开会话', system: 'RULE_B · DESC_B · NEW_SKILL', messages: ['hello'], note: en ? 'A brand-new session scans disk fresh and shares none of the earlier session’s message history.' : '新会话重新扫描磁盘拿到最新资源，旧会话的聊天历史不会带过来，只剩刚发出的 hello。' },
];
const id = (i: number) => `pi-request-${lang}-${i}`;
---
<figure class="requests">
  <fieldset>
    <legend>{en ? 'Inspect a captured Pi request' : '切换查看 Pi 实际发出的请求'}</legend>
    <div class="choices">
      {rows.map((row, i) => <label><input type="radio" name={`pi-requests-${lang}`} value={String(i)} aria-controls={id(i)} checked={i===1} /><span>{row.label}</span></label>)}
    </div>
    {rows.map((row, i) => <div class="packet" id={id(i)} data-step={i}>
      <dl><div><dt>{en ? 'effective system' : '当前生效的 system'}</dt><dd><code>{row.system}</code></dd></div>
          <div><dt>{en ? 'user history' : '历次用户消息'}</dt><dd>{row.messages.map(m => <code>{m}</code>)}</dd></div></dl>
      <p>{row.note}</p>
    </div>)}
  </fieldset>
  <figcaption>{en ? 'Figure 3. Selected excerpts from the captured requests. Each chip in the user row represents one message, in send order.' : '图 3　五次请求里实际发给模型的关键标记。下排每个方框对应一条用户消息，按发送顺序排列。'}</figcaption>
</figure>
<style>
  fieldset{min-inline-size:0;margin:0;padding:0;border:0}
  legend{padding:0;font:600 1rem/1.6 var(--sans);color:var(--fg)}
  .choices{display:flex;flex-wrap:wrap;gap:.3rem .9rem;border-bottom:1px solid var(--line);padding:.65rem 0}
  label{position:relative;cursor:pointer;font: .84rem/1.65 var(--sans);color:var(--mute);padding:.12rem .15rem}
  label input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
  label:has(:checked){color:var(--fg);box-shadow:inset 0 -2px var(--plat-ink)}
  label:has(:focus-visible){outline:2px solid var(--plat-ink);outline-offset:2px}
  .packet{display:none}
  fieldset:has([value="0"]:checked) [data-step="0"], fieldset:has([value="1"]:checked) [data-step="1"],
  fieldset:has([value="2"]:checked) [data-step="2"], fieldset:has([value="3"]:checked) [data-step="3"],
  fieldset:has([value="4"]:checked) [data-step="4"]{display:block}
  dl{margin:1rem 0 .65rem} dl>div{display:grid;grid-template-columns:minmax(70px,21%) 1fr;align-items:baseline;gap:8px;margin:.45rem 0}
  dt{font:.79rem/1.7 var(--mono);color:var(--mute)} dd{display:flex;flex-wrap:wrap;gap:.35rem;margin:0}
  dd code{font:.82rem/1.5 var(--mono);padding:.12rem .35rem;overflow-wrap:anywhere}
  .packet p{margin:.65rem 0;font-size:.92rem;color:var(--fg-2)}
  @media print{.choices{display:none}.packet{display:block}}
</style>
