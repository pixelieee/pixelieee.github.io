---
// 一条规则与一个 Skill 穿过磁盘编辑、/reload、压缩和分支切换的完整时间线。
const { lang = 'zh' } = Astro.props;
const T = {
  zh: {
    label: { rule: '上下文文件', skill: 'Skill', both: '规则 + Skill + 会话树' },
    steps: [
      {
        when: '会话启动 · 第 1 轮',
        lane: 'both',
        title: '用户输入 /skill:release',
        body: 'Pi 在启动时把 AGENTS.md（RULE_A）和 release 的简介（DESC_A）写进首条 system 消息。用户输入 /skill:release 后，Pi 在内存索引表里查到文件路径，当场读取磁盘上的 BODY_A，展开成第 1 条 user 消息追加进会话树。',
      },
      {
        when: '会话运行中 · 修改磁盘文件',
        lane: 'both',
        title: 'AGENTS.md 改成 RULE_B，release 改成 DESC_B / BODY_B，另新建 late',
        body: 'Pi 没有文件监听器，内存里缓存的规则与 Skill 索引表原封不动。磁盘变了，正在运行的会话并不知道。',
      },
      {
        when: '第 2–3 轮 · 不重载直接调用',
        lane: 'skill',
        title: '同一份请求里同时出现 RULE_A、BODY_A 和 BODY_B',
        body: '第 2 轮再次输入 /skill:release：因为 release 已在索引表中，Pi 重新读磁盘拿到最新的 BODY_B 追加为第 2 条 user 消息；但 system prompt 仍是旧的 RULE_A · DESC_A，第 1 条 user 消息里的 BODY_A 也照旧随分支发送。第 3 轮输入 /skill:late：索引表里还没有 late，命令没被展开，直接当成普通聊天文字发给了模型。',
      },
      {
        when: '执行 /reload · 第 4 轮',
        lane: 'both',
        title: '追加一条新的 system 更新消息，而不是改写开头',
        body: 'Pi 重新扫描磁盘，对比当前分支已生效的各个段落与新内容，把有变化的部分作为一条新 system 消息追加到末尾（包含 RULE_B · DESC_B · NEW_SKILL）。支持对话中途插入 system 消息的服务商直接保留前面的缓存前缀；不支持的服务商则在发送前合并成一条新开头。',
      },
      {
        when: '会话变长 · 触发压缩',
        lane: 'both',
        title: 'system 状态合并进快照，旧消息换成摘要',
        body: '生成压缩记录时，Pi 先把合并后的最新 system 提示词存进 CompactionEntry.systemMessage，再用摘要替换 firstKeptEntryId（保留起点）之前的消息：早先展开的 BODY_A 被压进摘要，近期保留区里的消息仍在。',
      },
      {
        when: '执行 /tree · 切回第 1 轮的分支',
        lane: 'rule',
        title: '压缩记录留在原分支，旧分支恢复自己的历史',
        body: '新叶节点的祖先链上没有刚才那条压缩记录，模型重新看到第 1 轮的原文；下一次发请求前，Pi 会对比这条旧分支的 system 内容与内存里已加载的最新资源，把 RULE_B 同步到这条分支上。',
      },
    ],
  },
  en: {
    label: { rule: 'context file', skill: 'skill', both: 'both + session tree' },
    steps: [
      {
        when: 'Session start · turn 1',
        lane: 'both',
        title: 'The user runs /skill:release',
        body: 'At startup ResourceLoader puts AGENTS.md (RULE_A) and the release description (DESC_A) into the leading system message. /skill:release finds the name in the cached catalog, reads BODY_A straight from disk, and appends it as user message #1.',
      },
      {
        when: 'Mid-session · disk edited',
        lane: 'both',
        title: 'AGENTS.md becomes RULE_B, release becomes DESC_B / BODY_B, and late is created',
        body: 'Pi runs no file watcher, so the rules and skill catalog cached in memory at startup stay untouched. Disk has changed; the running session has no idea.',
      },
      {
        when: 'Turn 2 · /skill:release again',
        lane: 'skill',
        title: 'One request carries RULE_A, BODY_A and BODY_B together',
        body: 'release is already registered, so /skill:release rereads disk and appends BODY_B as user message #2; the system prompt is still RULE_A · DESC_A, and BODY_A in user message #1 still rides along on the branch. A follow-up /skill:late misses the catalog and reaches the model as literal text.',
      },
      {
        when: 'Run /reload · turn 4',
        lane: 'both',
        title: 'A system diff is appended instead of rewriting the head',
        body: 'ResourceLoader rescans disk. Pi diffs the replayed sections against the new ones and appends a system message carrying RULE_B · DESC_B · NEW_SKILL. Providers that accept mid-conversation system messages keep their cached prefix in place; others merge the replay into a new leading prompt.',
      },
      {
        when: 'Longer session · compaction fires',
        lane: 'both',
        title: 'System state folds into a snapshot; old turns become a summary',
        body: 'appendCompaction saves the replayed system state on CompactionEntry.systemMessage and replaces entries before firstKeptEntryId with the summary (the early BODY_A expansion is folded into the summary while recent kept turns stay verbatim).',
      },
      {
        when: 'Run /tree · back to turn 1',
        lane: 'rule',
        title: 'The checkpoint stays on the branch you left',
        body: 'The older leaf has no compaction entry on its ancestry, so turn 1 returns verbatim; before the next request, Pi diffs that branch’s replayed system sections against the loaded resources and patches RULE_B onto it too.',
      },
    ],
  },
};
const t = T[lang] ?? T.zh;
---
<ol class="journey" lang={lang === 'en' ? 'en' : 'zh-CN'}>
  {t.steps.map((s) => (
    <li class={s.lane}>
      <div class="j-when">{s.when}<span class="j-lane">{t.label[s.lane]}</span></div>
      <div class="j-title">{s.title}</div>
      <p class="j-body">{s.body}</p>
    </li>
  ))}
</ol>
<style>
  .journey { list-style: none; margin: 2em 0; padding: 0 0 0 22px; border-left: 1px solid var(--line); position: relative; }
  .journey li { position: relative; padding: 0 0 1.5em; margin: 0; }
  .journey li:last-child { padding-bottom: .2em; }
  .journey li::before { content: ""; position: absolute; left: -26.5px; top: .55em; width: 8px; height: 8px; background: var(--bg); border: 1.5px solid var(--mute); border-radius: 1px; }
  .journey li.skill::before { border-color: var(--plat); }
  .journey li.both::before { background: linear-gradient(135deg, var(--plat-hi), var(--plat) 55%, var(--plat-lo)); border-color: var(--plat); }
  .j-when { font: 12px/1.6 var(--mono); color: var(--mute); display: flex; gap: 10px; flex-wrap: wrap; }
  .j-lane { color: var(--plat-ink); }
  .j-title { font-weight: 600; margin: 2px 0 4px; line-height: 1.6; }
  .j-body { margin: 0 !important; color: var(--fg-2); font-size: 15.5px; line-height: 1.8; }
</style>
