---
// 图 2：一次 Background Review 从计数到落盘的路径（纵向时间线）。
const { lang = 'zh' } = Astro.props;
const T = {
  zh: {
    aria: 'Background Review 的五个步骤',
    steps: [
      ['累计计数', '用户轮 ≥ 10（记忆），或模型请求 ≥ 10（Skill）'],
      ['回合收尾', '有最终答复、回合未中断、复盘未被跳过'],
      ['复制消息', '当前会话仍保留的全部消息的快照'],
      ['后台 fork', '临时 AIAgent，白名单工具，默认不含 terminal'],
      ['落盘', '默认记忆写入：add 直接写；patch / remove 等待批准'],
    ],
    cap: '图 2　一次 Background Review 的路径。第 5 步中 patch / remove 暂存后，要用户执行 /memory approve 才会生效。',
  },
  en: {
    aria: 'The five steps of a background review',
    steps: [
      ['Count', 'user turns ≥ 10 (memory) or model requests ≥ 10 (skills)'],
      ['Turn ends', 'final answer present, turn uninterrupted, review permitted'],
      ['Snapshot', 'copy of every message the session still holds'],
      ['Fork', 'temporary AIAgent, whitelisted tools, no terminal'],
      ['Write', 'Memory by default: add writes directly; patch / remove await approval'],
    ],
    cap: 'Figure 2. One background review, end to end. In step 5, a staged patch or remove takes effect only after /memory approve.',
  },
};
const t = T[lang] ?? T.zh;
const H = 56;
const en = lang === 'en';
---
<figure class="fig2" lang={en ? 'en' : 'zh-CN'}>
<div class="fig-scroll"><svg viewBox={`0 0 760 ${t.steps.length * H + 8}`} role="img" aria-label={t.aria}>
  <path d={`M24 ${H / 2 + 4} V${(t.steps.length - 1) * H + H / 2 + 4}`} class="rail" />
  {t.steps.map(([title, desc], i) => (
    <g transform={`translate(0,${i * H + 4})`}>
      <circle cx="24" cy={H / 2} r="13" class="c" />
      <text x="24" y={H / 2 + 5} class="n" text-anchor="middle">{i + 1}</text>
      <text x="56" y={H / 2 + 6} class="h">{title}</text>
      <text x={en ? 168 : 170} y={H / 2 + 6} class="m">{desc}</text>
      {i < t.steps.length - 1 && <path d={`M56 ${H} H752`} class="sep" />}
    </g>
  ))}
</svg></div>
<figcaption>{t.cap}</figcaption>
<style>
.fig2 svg{width:100%;height:auto;display:block}
.fig2 .rail{stroke:var(--line);stroke-width:1.5}
.fig2 .sep{stroke:var(--line);stroke-width:1}
.fig2 .c{fill:var(--bg);stroke:var(--plat);stroke-width:1.5}
.fig2 text{fill:var(--fg);font-size:16px;font-family:-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}
.fig2 .n{fill:var(--plat-ink);font-size:13px;font-family:'JetBrains Mono',monospace}
.fig2 .h{font-weight:600}
.fig2 .m{fill:var(--mute);font-size:15px}
</style>
</figure>
