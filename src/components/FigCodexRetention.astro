---
const english = Astro.props.lang === 'en';
const text = english ? {
  title: 'One source disappears in two separate steps',
  columns: ['Moment', 'SQLite rows', 'Disk source files', 'Global job'],
  moments: ['First consolidation done', 'Re-extracted as empty', 'New turn after 6h cooldown'],
  caption: 'Figure 2. Observed counts in the seeded-summary run. Across all three moments, memory_summary.md kept its prior marker untouched.',
} : {
  title: '同一个来源分两步消失（受第二道 6 小时冷却控制）',
  columns: ['观察时刻', '数据库提取行', '磁盘来源文件', '全局任务'],
  moments: ['首次整理成功', '再次提取为空', '过 6h 冷却再开回合'],
  caption: '图 2\u3000有旧摘要组的实测计数。三个时刻的总摘要都保留了原来的旧标记。',
};
const observations = [[1, 1, 'done'], [0, 1, 'pending'], [0, 0, 'done']];
const titleId = `codex-source-retention-${english ? 'en' : 'zh'}`;
---
<figure class="retention" lang={english ? 'en' : 'zh-CN'} aria-labelledby={titleId}>
  <div class="panel">
    <div class="heading" id={titleId}>{text.title}</div>
    <table aria-labelledby={titleId}>
      <thead><tr>{text.columns.map((label) => <th scope="col">{label}</th>)}</tr></thead>
      <tbody>
        {observations.map(([db, disk, job], index) => (
          <tr>
            <th scope="row">{text.moments[index]}</th>
            <td><span class:list={['count', { present: db === 1 }]}>{db}</span></td>
            <td><span class:list={['count', { present: disk === 1 }]}>{disk}</span></td>
            <td><span class:list={['state', { queued: job === 'pending' }]}>{job}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>{text.caption}</figcaption>
</figure>

<style>
  .retention { container-type: inline-size; margin: 1.8em 0; }
  .panel { padding: 1rem 1.15rem; border: 1px solid var(--line); border-radius: 10px; background: var(--card); }
  .heading { color: var(--fg); font: 600 1rem/1.45 var(--sans); }
  .panel table { display: table; width: 100%; min-width: 0; margin: .7rem 0 0; border-collapse: collapse; table-layout: fixed; }
  .panel th, .panel td { padding: .45rem .3rem; border: 0; border-bottom: 1px solid var(--line); white-space: normal; }
  .panel th:first-child { width: 38%; padding-left: 0; }
  .panel th:not(:first-child), .panel td { text-align: center; }
  .panel thead th { color: var(--mute); font: 400 .86rem/1.4 var(--sans); text-transform: none; letter-spacing: 0; }
  .panel tbody th { color: var(--fg-2); font: 500 .92rem/1.45 var(--sans); text-align: left; }
  .panel tbody tr:last-child > * { border-bottom: 0; }
  .count { display: inline-block; min-width: 2.2rem; border-radius: 4px; color: var(--mute); font: 500 .96rem/1.7 var(--mono); }
  .present { background: var(--plat-soft); color: var(--fg); }
  .state { color: var(--mute); font: .86rem/1.4 var(--mono); }
  .queued { color: var(--fg); font-weight: 600; }
</style>
