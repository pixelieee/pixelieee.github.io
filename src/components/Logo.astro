---
import { Image } from 'astro:assets';
import portrait from '../../public/portraits/mature-original/white/portrait.png';

const { size = 48 } = Astro.props;
---
<Image
  src={portrait}
  width={size}
  height={size}
  densities={[1, 1.25, 1.5, 1.75, 2, 3, 4]}
  format="png"
  loading="eager"
  alt=""
  class="logo"
/>

<style>
  .logo {
    display: block;
    border-radius: 20%;
  }
</style>
