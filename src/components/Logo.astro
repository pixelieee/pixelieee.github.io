---
// pixel notes 标志：一枚圆环（pure）与嵌在环上的白金像素（pixel）。
const { size = 22 } = Astro.props;
const gid = 'lg-' + Math.random().toString(36).slice(2, 8);
---
<svg width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" class="logo">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color:var(--plat-hi)" />
      <stop offset=".55" style="stop-color:var(--plat)" />
      <stop offset="1" style="stop-color:var(--plat-lo)" />
    </linearGradient>
  </defs>
  <circle cx="15" cy="17" r="10.5" fill="none" stroke="currentColor" stroke-width="2.6" />
  <rect x="18.6" y="5.6" width="8" height="8" fill={`url(#${gid})`} style="stroke:var(--bg)" stroke-width="2.4" paint-order="stroke" />
</svg>
