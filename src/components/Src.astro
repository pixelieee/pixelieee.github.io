---
// 源码引用：固定到笔记所用提交，显示为 文件名:行号。
const { p, l, label, repo = 'NousResearch/hermes-agent', rev = 'bf0203a794a07aac3ff764972ab9087baa4e4f4e' } = Astro.props;
const hash = l ? `#L${String(l).split('-').join('-L')}` : '';
const href = `https://github.com/${repo}/blob/${rev}/${p}${hash}`;
const text = label ?? `${p.split('/').pop()}${l ? ':' + l : ''}`;
---
<a class="src" href={href} target="_blank" rel="noopener" title={`${p}${l ? ' L' + l : ''} @ ${rev.slice(0, 7)}`}>{text}</a>
